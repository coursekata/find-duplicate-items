{
  "name": "@coursekata/find-duplicate-items",
  "description": "GitHub Action to find duplicate items in CourseKata courses.",
  "version": "2.2.2",
  "author": "Adam Blake <adam@coursekata.org>",
  "type": "module",
  "private": true,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/coursekata/find-duplicate-items.git"
  },
  "bugs": {
    "url": "https://github.com/coursekata/find-duplicate-items/issues"
  },
  "keywords": [
    "coursekata",
    "actions",
    "validate",
    "duplicate"
  ],
  "exports": {
    ".": "./dist/index.js"
  },
  "bin": {
    "find-duplicate-items": "./dist/cli.js"
  },
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "bundle": "npm run check:fix && npm run package",
    "ci-test": "NODE_OPTIONS=--experimental-vm-modules npx jest",
    "coverage": "npx make-coverage-badge --output-path ./badges/coverage.svg",
    "check": "biome check",
    "check:fix": "biome check --write",
    "lint": "npm run lint:markdown && npm run lint:actions",
    "lint:markdown": "markdownlint '**/*.md' --ignore node_modules --ignore dist --ignore coverage",
    "lint:actions": "(command -v actionlint >/dev/null && actionlint || echo 'actionlint not found, skipping') && (command -v zizmor >/dev/null && zizmor .github/workflows/ || echo 'zizmor not found, skipping')",
    "package": "rollup -c rollup.config.ts --configPlugin @rollup/plugin-typescript",
    "package:watch": "rollup -c rollup.config.ts --configPlugin @rollup/plugin-typescript --watch",
    "test": "NODE_OPTIONS=--experimental-vm-modules npx jest",
    "typecheck": "tsc --noEmit",
    "all": "npm run check:fix && npm run lint && npm run test && npm run coverage && npm run package",
    "prepare": "command -v lefthook >/dev/null && lefthook install || true",
    "start": "node dist/index.js"
  },
  "dependencies": {
    "@actions/core": "^3.0.0",
    "@actions/glob": "^0.6.1",
    "htmlparser2": "^10.1.0",
    "markdown-it": "^14.1.0",
    "markdown-it-attrs": "^4.3.0",
    "markdown-it-container": "^4.0.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.10",
    "@jest/globals": "^29.7.0",
    "@rollup/plugin-commonjs": "^29.0.0",
    "@rollup/plugin-node-resolve": "^16.0.0",
    "@rollup/plugin-typescript": "^12.0.0",
    "@types/jest": "^29.5.14",
    "@types/markdown-it": "^14.1.2",
    "@types/markdown-it-attrs": "^4.1.3",
    "@types/markdown-it-container": "^4.0.0",
    "@types/node": "^22.10.2",
    "jest": "^29.7.0",
    "lefthook": "^2.0.13",
    "make-coverage-badge": "^1.2.0",
    "markdownlint-cli": "^0.47.0",
    "rollup": "^4.0.0",
    "ts-jest": "^29.2.5",
    "ts-jest-resolver": "^2.0.1",
    "tslib": "^2.8.1",
    "typescript": "^5.7.2"
  }
}
